{
  "name": "webtor-onion-gateway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "backend": "cargo run -q -p webtor-directory-server -- serve",
    "backend:ts": "cd ../directory-server-ts && bun run serve",
    "test": "bun test src",
    "test:e2e": "bun test --timeout 600000 e2e"
  },
  "dependencies": {
    "@andrewtheguy/webtor-wasm": "file:../../crates/webtor-wasm/pkg",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright-core": "^1.50.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
